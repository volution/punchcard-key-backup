!!


<< inkscape / export / cr80
	test "${#}" -eq 0
	inkscape \
			--export-type=svg \
			--export-filename=./stencils/cr80--export.svg \
			--export-overwrite \
			--export-area-drawing \
			--export-dpi=96 \
			--export-plain-svg \
			--export-text-to-path \
			./stencils/cr80--inkscape.svg \
	#
	inkscape \
			--export-type=png \
			--export-filename=./stencils/cr80--export.png \
			--export-overwrite \
			--export-area-drawing \
			--export-dpi=480 \
			--export-png-color-mode=RGB_8 \
			--export-png-compression=9 \
			--export-png-antialias=0 \
			--export-png-use-dithering=false \
			./stencils/cr80--inkscape.svg \
	#
!!


