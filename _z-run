#!/usr/bin/local/z-run --exec




<< generate / html / watch
	exec -- watchexec \
			-w ./generate-html.py \
			-w ./generate-html.js \
			-w ./generate-html.css \
			-n \
			-- \
			"${ZRUN}" ':: generate / html' \
	#
!!


<< generate / html
	test "${#}" -eq 0
	exec -- python3 ./generate-html.py >| ./generate.html
!!


<< generate / html / open
	test "${#}" -eq 0
	exec -- x-www firefox-guest:pckb open file://"$( exec -- readlink -e -- ./generate.html )"
!!


